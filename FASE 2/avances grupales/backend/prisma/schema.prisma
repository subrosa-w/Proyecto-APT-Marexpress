  @@index([idOrden], map: "fk_entrega_orden")
  @@index([idUsuario], map: "fk_entrega_usuario")
}

model estado_ot {
  idEstado         Int                @id @default(autoincrement())
  nombreEstado     String             @unique(map: "nombreEstado") @db.VarChar(50)
  descripcion      String?            @db.VarChar(150)
