generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model cliente {
  idCliente         Int                 @id @default(autoincrement())
  rut               String              @unique(map: "rut") @db.VarChar(12)
  razonSocial       String              @db.VarChar(150)
  nombreFantasia    String?             @db.VarChar(150)
  giro              String?             @db.VarChar(150)
  direccion         String              @db.VarChar(200)
  telefono          String?             @db.VarChar(20)
  correo            String?             @db.VarChar(150)
  estado            Boolean             @default(true)
  idComuna          Int
  comuna            comuna              @relation(fields: [idComuna], references: [idComuna], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_comuna")
  cliente_ubicacion cliente_ubicacion[]
  cliente_usuario   cliente_usuario[]
  cuenta_corriente  cuenta_corriente?
  orden_transporte  orden_transporte[]

  @@index([idComuna], map: "fk_cliente_comuna")
}

model cliente_usuario {
  idClienteUsuario Int      @id @default(autoincrement())
  idCliente        Int
  idUsuario        Int
  fechaAsignacion  DateTime @default(now()) @db.DateTime(0)
  estado           Boolean  @default(true)
  cliente          cliente  @relation(fields: [idCliente], references: [idCliente], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_usuario_cliente")
  usuario          usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_usuario_usuario")

  @@unique([idCliente, idUsuario], map: "uq_cliente_usuario")
  @@index([idUsuario], map: "fk_cliente_usuario_usuario")
}

model comuna {
  idComuna                                                  Int                 @id @default(autoincrement())
  nombreComuna                                              String              @db.VarChar(100)
  idRegion                                                  Int
  estado                                                    Boolean             @default(true)
  cliente                                                   cliente[]
  cliente_ubicacion                                         cliente_ubicacion[]
  region                                                    region              @relation(fields: [idRegion], references: [idRegion], onDelete: NoAction, onUpdate: NoAction, map: "fk_comuna_region")
  orden_transporte_orden_transporte_idComunaDestinoTocomuna orden_transporte[]  @relation("orden_transporte_idComunaDestinoTocomuna")
  orden_transporte_orden_transporte_idComunaOrigenTocomuna  orden_transporte[]  @relation("orden_transporte_idComunaOrigenTocomuna")
  sucursal                                                  sucursal[]
  tarifa_trayecto_tarifa_trayecto_idComunaDestinoTocomuna   tarifa_trayecto[]   @relation("tarifa_trayecto_idComunaDestinoTocomuna")
  tarifa_trayecto_tarifa_trayecto_idComunaOrigenTocomuna    tarifa_trayecto[]   @relation("tarifa_trayecto_idComunaOrigenTocomuna")

  @@unique([nombreComuna, idRegion], map: "uq_comuna_region")
  @@index([idRegion], map: "fk_comuna_region")
}

model conductor {
  idConductor         Int          @id @default(autoincrement())
  rut                 String       @unique(map: "rut") @db.VarChar(12)
  nombre              String       @db.VarChar(100)
  apellido            String       @db.VarChar(100)
  telefono            String?      @db.VarChar(20)
  licencia            String       @db.VarChar(20)
  vencimientoLicencia DateTime?    @db.Date
  estado              Boolean      @default(true)
  manifiesto          manifiesto[]
}

model cuenta_corriente {
  idCuenta          Int                 @id @default(autoincrement())
  fechaApertura     DateTime            @db.Date
  limiteCredito     Decimal?            @default(0.00) @db.Decimal(12, 2)
  saldoActual       Decimal?            @default(0.00) @db.Decimal(12, 2)
  estado            Boolean             @default(true)
  idCliente         Int                 @unique(map: "uq_cuenta_corriente_cliente")
  cliente           cliente             @relation(fields: [idCliente], references: [idCliente], onDelete: NoAction, onUpdate: NoAction, map: "fk_cuenta_cliente")
  movimiento_cuenta movimiento_cuenta[]
  pago              pago[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_carga {
  idDetalleCarga   Int                @id @default(autoincrement())
  descripcion      String             @db.VarChar(200)
  cantidad         Int
  pesoUnitario     Decimal?           @db.Decimal(10, 2)
  pesoTotal        Decimal?           @db.Decimal(10, 2)
  largoCm          Decimal?           @db.Decimal(10, 2)
  anchoCm          Decimal?           @db.Decimal(10, 2)
  altoCm           Decimal?           @db.Decimal(10, 2)
  volumenM3        Decimal?           @db.Decimal(12, 4)
  valorDeclarado   Decimal?           @db.Decimal(12, 2)
  observacion      String?            @db.VarChar(200)
  idOrden          Int
  idTipoBulto      Int
  bulto            bulto[]
  orden_transporte orden_transporte   @relation(fields: [idOrden], references: [idOrden], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_carga_orden")
  tipo_bulto       tipo_bulto         @relation(fields: [idTipoBulto], references: [idTipoBulto], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_carga_tipo_bulto")
  entrega_carga    entrega_carga[]
  manifiesto_carga manifiesto_carga[]

  @@index([idOrden], map: "fk_detalle_carga_orden")
  @@index([idTipoBulto], map: "fk_detalle_carga_tipo_bulto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model entrega_carga {
  idEntregaCarga    Int           @id @default(autoincrement())
  idEntrega         Int
  idDetalleCarga    Int
  cantidadEntregada Int
  pesoEntregado     Decimal?      @db.Decimal(10, 2)
  observacion       String?       @db.VarChar(200)
  detalle_carga     detalle_carga @relation(fields: [idDetalleCarga], references: [idDetalleCarga], onDelete: NoAction, onUpdate: NoAction, map: "fk_entrega_carga_detalle")
  entrega_ot        entrega_ot    @relation(fields: [idEntrega], references: [idEntrega], onDelete: NoAction, onUpdate: NoAction, map: "fk_entrega_carga_entrega")

  @@unique([idEntrega, idDetalleCarga], map: "uq_entrega_carga")
  @@index([idDetalleCarga], map: "fk_entrega_carga_detalle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model entrega_ot {
  idEntrega        Int              @id @default(autoincrement())
  fechaEntrega     DateTime         @default(now()) @db.DateTime(0)
  resultadoEntrega String           @db.VarChar(30)
  motivoResultado  String?          @db.VarChar(250)
  nombreReceptor   String?          @db.VarChar(150)
